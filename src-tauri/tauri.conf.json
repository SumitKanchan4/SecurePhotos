{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "SecurePhotos",
  "version": "0.1.0",
  "identifier": "com.securephotos.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SecurePhotos",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*"
      },
      "capabilities": [
        "default"
      ],
      "devCsp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:1420 ws://localhost:1420"
      }
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "SecurePhotos Engine"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWQyl3kodkHNll7SOXOALT+xkITzPREjLsLw8fO7jZ95D52y3UVuUeY+",
      "endpoints": [
        "https://github.com/SumitKanchan4/SecurePhotos/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "licenseFile": "EULA.txt",
    "externalBin": [
      "binaries/securephotos-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "../bin/ffprobe.exe": "bin/ffprobe.exe",
      "../build/models/*": "data/models/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
